{
  "name": "cw-website",
  "version": "1.0.0",
  "description": "Personal portfolio website for Ash Crockett, full-stack software engineer.",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint src/ .devin/vitest.config.mts",
    "lint:fix": "eslint src/ .devin/vitest.config.mts --fix",
    "format": "prettier \"src/**/*.{ts,tsx}\" .devin/vitest.config.mts .devin/tsconfig.test.json --write",
    "format:check": "prettier \"src/**/*.{ts,tsx}\" .devin/vitest.config.mts .devin/tsconfig.test.json --check",
    "test": "vitest run --config .devin/vitest.config.mts",
    "test:watch": "vitest --config .devin/vitest.config.mts",
    "test:coverage": "vitest run --coverage --config .devin/vitest.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p .devin/tsconfig.test.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ash-c/cw-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ash-c/cw-website/issues"
  },
  "homepage": "https://github.com/ash-c/cw-website#readme",
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^3.33.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webpack-env": "^1.18.8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "html-webpack-plugin": "^5.6.6",
    "jsdom": "29.1.1",
    "prettier": "^3.3.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "4.1.12",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
